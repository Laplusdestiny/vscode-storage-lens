{
  "name": "vscode-storage-lens",
  "displayName": "Storage Lens",
  "description": "VS Code のキャッシュ・拡張機能・ワークスペース状態の容量を一覧して掃除する",
  "version": "0.1.0",
  "publisher": "laplusdestiny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laplusdestiny/vscode-storage-lens"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vscode-test",
    "package": "vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
