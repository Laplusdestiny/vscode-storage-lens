{
  "name": "vscode-storage-lens",
  "displayName": "Storage Lens",
  "description": "VS Code のキャッシュ・拡張機能・ワークスペース状態の容量を一覧して掃除する",
  "version": "0.1.0",
  "publisher": "laplusdestiny",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Laplusdestiny/vscode-storage-lens"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "storageLens",
          "title": "Storage Lens",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "storageLens": [
        {
          "id": "storageLens.view",
          "name": "容量"
        }
      ]
    },
    "commands": [
      {
        "command": "storageLens.refresh",
        "title": "更新",
        "category": "Storage Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "storageLens.deleteSelected",
        "title": "選んだものを削除",
        "category": "Storage Lens",
        "icon": "$(trash)"
      },
      {
        "command": "storageLens.uninstallSelected",
        "title": "選んだ拡張をアンインストール",
        "category": "Storage Lens",
        "icon": "$(extensions)"
      },
      {
        "command": "storageLens.deleteEntry",
        "title": "削除",
        "category": "Storage Lens",
        "icon": "$(trash)"
      },
      {
        "command": "storageLens.uninstall",
        "title": "アンインストール",
        "category": "Storage Lens",
        "icon": "$(circle-slash)"
      },
      {
        "command": "storageLens.reveal",
        "title": "フォルダを開く",
        "category": "Storage Lens",
        "icon": "$(folder-opened)"
      },
      {
        "command": "storageLens.copyPath",
        "title": "パスをコピー",
        "category": "Storage Lens",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "storageLens.refresh",
          "when": "view == storageLens.view",
          "group": "navigation@1"
        },
        {
          "command": "storageLens.deleteSelected",
          "when": "view == storageLens.view",
          "group": "navigation@2"
        },
        {
          "command": "storageLens.uninstallSelected",
          "when": "view == storageLens.view",
          "group": "more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "storageLens.deleteEntry",
          "when": "view == storageLens.view && viewItem =~ /deletable/",
          "group": "inline@1"
        },
        {
          "command": "storageLens.uninstall",
          "when": "view == storageLens.view && viewItem =~ /extension/",
          "group": "inline@2"
        },
        {
          "command": "storageLens.reveal",
          "when": "view == storageLens.view && viewItem =~ /^entry/",
          "group": "inline@3"
        },
        {
          "command": "storageLens.deleteEntry",
          "when": "view == storageLens.view && viewItem =~ /deletable/",
          "group": "1_actions@1"
        },
        {
          "command": "storageLens.uninstall",
          "when": "view == storageLens.view && viewItem =~ /extension/",
          "group": "1_actions@2"
        },
        {
          "command": "storageLens.reveal",
          "when": "view == storageLens.view && viewItem =~ /^entry/",
          "group": "1_actions@3"
        },
        {
          "command": "storageLens.copyPath",
          "when": "view == storageLens.view && viewItem =~ /^entry/",
          "group": "2_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "storageLens.deleteEntry",
          "when": "false"
        },
        {
          "command": "storageLens.uninstall",
          "when": "false"
        },
        {
          "command": "storageLens.reveal",
          "when": "false"
        },
        {
          "command": "storageLens.copyPath",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node esbuild.mjs --smoke && vscode-test",
    "package": "vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
